{
  "name": "medclinic-api",
  "version": "1.0.0",
  "description": "MedClinic API - Etapa 2: Agendamento, escala e prontuário",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "typeorm": "ts-node -e \"require('ts-node/register')\" ./node_modules/typeorm/cli.js",
    "migration:run": "npm run build && node -e \"const {AppDataSource} = require('./dist/config/database'); AppDataSource.initialize().then(() => AppDataSource.runMigrations()).then(() => { console.log('Migrations OK'); process.exit(0); }).catch(e => { console.error(e); process.exit(1); })\"",
    "migration:generate": "npx typeorm migration:generate -d src/config/database.ts",
    "migration:revert": "npx typeorm migration:revert -d src/config/database.ts",
    "seed": "npm run build && node dist/database/seeds/adminSeed.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "^2.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
